
erDiagram
    Users ||--o{ Applications : creates
    Users ||--o{ SecurityPolicies : creates
    Users ||--o{ AuditLogs : performs

    Applications ||--o{ Endpoints : contains
    Applications ||--o{ SecurityEvents : records

    Endpoints o|--o{ SecurityEvents : identifies
    SecurityPolicies ||--o{ SecurityEvents : governs

    SecurityEvents ||--o{ ThreatFindings : contains
    DetectionRules o|--o{ ThreatFindings : identifies

    Users {
        BIGINT user_id PK
        NVARCHAR email UK
        NVARCHAR password_hash
        VARCHAR role
        BIT is_active
        DATETIME2 created_at
        DATETIME2 updated_at
    }

    Applications {
        BIGINT application_id PK
        NVARCHAR name
        NVARCHAR description
        BIT is_active
        BIGINT created_by FK
        DATETIME2 created_at
        DATETIME2 updated_at
    }

    Endpoints {
        BIGINT endpoint_id PK
        BIGINT application_id FK
        NVARCHAR path_pattern
        VARCHAR http_method
        NVARCHAR description
        BIT is_active
        DATETIME2 created_at
    }

    DetectionRules {
        BIGINT rule_id PK
        NVARCHAR name UK
        VARCHAR category
        NVARCHAR description
        VARCHAR severity
        INT weight
        BIT is_critical
        BIT is_enabled
        DATETIME2 created_at
        DATETIME2 updated_at
    }

    SecurityPolicies {
        BIGINT policy_id PK
        NVARCHAR name UK
        NVARCHAR description
        INT risk_threshold
        BIT is_enabled
        BIGINT created_by FK
        DATETIME2 created_at
        DATETIME2 updated_at
    }

    SecurityEvents {
        BIGINT event_id PK
        BIGINT application_id FK
        BIGINT endpoint_id FK
        BIGINT policy_id FK
        DATETIME2 request_time
        DATETIME2 created_at
        INT risk_score
        VARCHAR decision
        VARCHAR reason_code
        UNIQUEIDENTIFIER correlation_id
        VARCHAR http_method
        NVARCHAR request_path
        VARCHAR processing_status
    }

    ThreatFindings {
        BIGINT finding_id PK
        BIGINT event_id FK
        BIGINT rule_id FK
        NVARCHAR rule_name_snapshot
        VARCHAR category_snapshot
        VARCHAR severity_snapshot
        INT weight_snapshot
        BIT is_critical_snapshot
        DECIMAL confidence
        NVARCHAR evidence_summary
        DATETIME2 created_at
    }

    AuditLogs {
        BIGINT audit_id PK
        BIGINT user_id FK
        VARCHAR action
        VARCHAR entity_type
        NVARCHAR entity_id
        VARCHAR outcome
        UNIQUEIDENTIFIER correlation_id
        DATETIME2 created_at
        NVARCHAR details_summary
    }
